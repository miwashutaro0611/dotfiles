# Brewfile — install with `brew bundle --file=Brewfile`

# ─── CLI tools ────────────────────────────────────────────
brew "bat"           # cat with syntax highlighting
brew "eza"           # modern ls replacement
brew "gh"            # GitHub CLI
brew "git"
brew "lazygit"       # terminal UI for git
brew "mise"          # polyglot runtime version manager
brew "peco"          # interactive filtering (used in zsh history search)
brew "starship"      # cross-shell prompt
brew "zsh-completions"

# ─── Package managers / runtimes ──────────────────────────
brew "ni"            # universal npm/yarn/pnpm wrapper
brew "rbenv"         # Ruby version manager
brew "uv"            # fast Python package manager

# ─── Mobile / native dev ──────────────────────────────────
brew "cocoapods"

# ─── Media ────────────────────────────────────────────────
brew "ffmpeg"

# ─── GUI apps (casks) ─────────────────────────────────────
cask "claude-code"
cask "codex"
cask "cursor"
cask "flutter"
cask "jordanbaird-ice" # menu bar manager

